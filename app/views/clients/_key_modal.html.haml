- content_for :modal do
  %dialog.api-key-modal.modal{open: true}
    .modal-box
      %form{method: 'dialog'}
        %button.btn.btn-circle.btn-ghost.btn-sm.absolute.top-2.right-2{aria: {label: t('actions.close')}}= icon 'close'
      %h3.text-lg.font-bold= t('.title')
      %p.my-4= t('.blurb')
      %code.api-key.block.rounded-box.bg-base-200.p-4.font-mono.text-xl.break-all= key
    %form.modal-backdrop{method: 'dialog'}
      %button= t('actions.close')
