= turbo_frame_tag [current_user, 'mailing_list'] do
  %h2.mb-4.text-2xl.font-bold= t('.title')
  .card.bg-base-100.shadow-md
    .card-body
      - if current_user.subscribed_to_mailing_list?
        %p= raw t('.currently_subscribed')
        .mt-4
          = button_to t('.unsubscribe'), users_mailing_list_unsubscribe_path, class: 'btn btn-danger'
      - else
        %p= raw t('.currently_unsubscribed')
        .mt-4
          = button_to t('.subscribe'), users_mailing_list_subscribe_path, class: 'btn btn-success'
