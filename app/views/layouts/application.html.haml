!!!
%html{lang: 'en'}
  %head= render 'layouts/head'
  %body.flex.min-h-screen.flex-col.bg-base-200
    %header
      = render 'layouts/navbar'
      = render 'layouts/messages'
    %main{class: ['flex grow flex-col', content_for(:main_class)]}= content_for?(:content) ? yield(:content) : yield
    %footer
      = render 'layouts/footer'
    = content_for :render_async
    = content_for :modal
