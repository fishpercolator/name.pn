%nav.navbar.flex-wrap.bg-neutral.text-neutral-content{role: 'navigation', aria: {label: t('layouts.navbar.label')}}
  .container.mx-auto.flex.flex-wrap.items-center
    = link_to root_path, class: 'flex flex-1 items-center gap-1 px-2 text-2xl md:flex-none' do
      = image_tag 'logo.svg', alt: t('icon_alt'), class: 'h-[1em]'
      %b= t('product_name')
    %label.btn.btn-square.btn-ghost.text-neutral-content{for: 'navbar-toggle', aria: {label: 'menu'}, class: 'md:hidden'}
      = icon 'menu', class: 'size-6 fill-current'
    %input#navbar-toggle.peer.hidden{type: 'checkbox'}
    %div{class: 'hidden w-full flex-col peer-checked:flex md:flex md:w-auto md:grow md:flex-row md:justify-between'}
      %ul{class: 'menu text-base md:menu-horizontal'}
        %li= link_to t('layouts.navbar.about'), page_path('about')
      %ul{class: 'menu text-base md:menu-horizontal'}
        - if user_signed_in?
          - if current_user.role_admin?
            %li= link_to t('layouts.navbar.admin'), admin_root_path
          %li= link_to t('devise.registrations.edit.title'), edit_user_registration_path
          %li= link_to t('devise.sessions.destroy.title'), destroy_user_session_path, data: {turbo_method: :delete}
        - else
          %li= link_to t('devise.sessions.new.title'), new_user_session_path
          %li= link_to t('devise.registrations.new.title'), new_user_registration_path
