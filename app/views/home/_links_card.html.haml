= render layout: 'card', locals: {id: 'links', step: :links, colour: 'bg-links', title: t('.title'), blurb: t('profile.links.blurb')} do
  - if current_user.links.present?
    %ul.list-disc.leading-7
      - current_user.links.order(:title).each do |link|
        %li= link_to link.title, link.url, rel: 'noopener', class: 'link'
  - else
    %p= not_set
