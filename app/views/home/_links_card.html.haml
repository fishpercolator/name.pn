= render layout: 'card', locals: {id: 'links', step: :links, colour: 'bg-links/10', title: t('.title'), blurb: t('profile.links.blurb')} do
  - if current_user.links.present?
    .prose.max-w-none
      %ul.ps-0
        - current_user.links.order(:title).each do |link|
          %li.ps-0= link_to link.title, link.url, rel: 'noopener'
  - else
    %p= not_set
