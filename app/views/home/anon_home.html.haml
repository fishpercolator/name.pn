%section.px-4.py-12.text-center
  %h1{class: 'inline-grid grid-cols-[1.15em_auto_auto] gap-px text-5xl leading-none font-bold whitespace-nowrap'}
    = image_tag 'logo.svg', alt: t('icon_alt'), class: 'h-[1em] pr-[0.15em]'
    %span.text-right= t('.title.namedot')
    %span.text-left= t('.title.pn')
    %span.col-start-3.pl-0.5.text-left.text-xl.text-primary
      = t('.title.pronouns')
      %br
      = t('.title.pronounce')
  %h2.mt-6.text-primary{class: 'text-[2rem]'}= t('.subtitle')
%section.container.mx-auto.px-4.py-12
  .grid.gap-6{class: 'md:grid-cols-3'}
    - features = [{icon: 'sticker-check-outline', title: '.get_your_name_right', blurb: '.name_right_blurb'},
      {icon: 'bullhorn', title: '.pronunciation', blurb: '.pronunciation_blurb'},
      {icon: 'gender-male-female', title: '.pronouns', blurb: '.pronouns_blurb'}]
    - features.each do |feature|
      %article.card.bg-base-100.shadow-md
        .card-body.flex-row.gap-4
          = icon feature[:icon], class: 'size-12 shrink-0 fill-current'
          %div
            %h3.card-title= t(feature[:title])
            %p.mt-4= t(feature[:blurb])
%section.container.mx-auto.space-y-5.px-4.py-12.text-center
  %p= link_to t('.sign_up_free'), new_user_registration_path, class: 'btn btn-secondary btn-xl'
  %p.text-muted= t('.warning')
  %p= link_to t('.learn_more'), page_path('about'), class: 'link link-secondary link-hover'
