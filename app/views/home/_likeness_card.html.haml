= render layout: 'card', locals: {id: 'likeness', step: :likeness, colour: 'bg-likeness', title: t('.title'), blurb: t('profile.likeness.blurb')} do
  - if current_user.likeness.attached?
    = link_to url_for(current_user.likeness), class: 'cursor-zoom-in', data: {controller: 'lightbox'} do
      = image_tag current_user.likeness.variant(resize_to_limit: [300, 300]), class: 'rounded-full'
  - else
    = not_set
