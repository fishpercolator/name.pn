= render layout: 'card', locals: {id: 'personal-name', step: :personal_name, colour: 'bg-personal-name/10', title: t('.title'), blurb: t('profile.personal_name.blurb')} do
  %dl.prose.max-w-none{class: 'prose-dd:mt-1 prose-ul:my-0 prose-li:my-0'}
    %dt= User.human_attribute_name(:personal_name)
    %dd
      - if current_user.personal_name?
        = current_user.personal_name
      - else
        = you_must
    %dt= User.human_attribute_name(:full_name)
    %dd
      - if current_user.full_name?
        = current_user.full_name
      - else
        = you_must
