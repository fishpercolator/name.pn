= render layout: 'card', locals: {id: 'personal-name', step: :personal_name, colour: 'bg-personal-name', title: t('.title'), blurb: t('profile.personal_name.blurb')} do
  %dl{class: 'leading-7 [&>dt]:mt-5 [&>dt]:font-bold [&>dt:first-child]:mt-0 [&>dd]:mt-1 [&>dd]:ms-6'}
    %dt= User.human_attribute_name(:personal_name)
    %dd
      - if current_user.personal_name?
        = current_user.personal_name
      - else
        = you_must
    %dt= User.human_attribute_name(:full_name)
    %dd
      - if current_user.full_name?
        = current_user.full_name
      - else
        = you_must
