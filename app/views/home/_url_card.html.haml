- item = 'dashboard-card__action btn btn-ghost h-auto flex-1 rounded-none border-0 py-3 font-normal text-secondary not-first:border-s not-first:border-base-300'
- footer = capture do
  = link_to profile_path(:slug), class: item do
    = icon 'pencil'
    = t('actions.edit')
  - if current_user.profile_complete?
    = link_to user_url(current_user), class: item, target: '_blank' do
      = icon 'open-in-new'
      = t('home.url_card.view_your_page')
    %button.group#copyButton{type: 'button', class: item, data: {url_target: 'copyButton', action: 'url#copy'}}
      %span.contents{class: 'group-[.copy-button--copied]:hidden'}
        = icon 'clipboard-outline'
        = t('home.url_card.copy_to_clipboard')
      %span.hidden{class: 'group-[.copy-button--copied]:contents'}
        = icon 'clipboard-check-outline'
        = t('home.url_card.copied')
  - else
    %button{type: 'button', class: item, disabled: true, title: t('home.url_card.you_must_complete')}
      = icon 'open-in-new'
      = t('home.url_card.view_your_page')
    %button{type: 'button', class: item, disabled: true, title: t('home.url_card.you_must_complete')}
      = icon 'clipboard-outline'
      = t('home.url_card.copy_to_clipboard')
%div{class: 'md:col-span-2', data: {controller: 'url', url_copied_class: 'copy-button--copied'}}
  = render layout: 'card', locals: {id: 'url', step: :slug, colour: 'bg-url', title: t('home.url_card.title'), footer: footer} do
    %p.break-words.text-center.text-2xl
      - if current_user.slug.present?
        %b{data: {url_target: 'url'}}= user_url(current_user, only_path: false)
      - else
        = you_must
    - if current_user.pronoun_sets.any?
      .text-center.text-muted
        %p
          %i= t('home.url_card.or_with_pronouns')
        - current_user.pronoun_sets.each do |ps|
          %p.break-words= user_url(current_user, only_path: false, nominative: ps.nominative, oblique: ps.oblique)
