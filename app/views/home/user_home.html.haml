.container.mx-auto.px-4.py-12
  %h1.page-title.text-4xl.font-bold= title t('.title')
  .mt-6.space-y-4.text-xl.text-muted
    %p= t('.page_description1')
    %p= t('.page_description2')
  .mt-12.grid.gap-6{class: 'md:grid-cols-2'}
    = render 'url_card'
    .flex.flex-col.gap-6{class: '[&>*]:grow'}
      = render 'name_card'
      = render 'pronouns_card'
      = render 'pronunciation_card'
    .flex.flex-col.gap-6{class: '[&>*]:grow'}
      = render 'name_variants_card'
      = render 'likeness_card'
      = render 'links_card'
