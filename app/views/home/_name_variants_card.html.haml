= render layout: 'card', locals: {id: 'variants', step: :variants, colour: 'bg-variants', title: t('.title'), blurb: t('profile.variants.blurb')} do
  %dl{class: 'leading-7 [&>dt]:mt-5 [&>dt]:font-bold [&>dt:first-child]:mt-0 [&>dd]:mt-1 [&>dd]:ms-6'}
    %dt= User.human_attribute_name(:envelope_name)
    %dd= current_user.envelope_name? ? current_user.envelope_name : not_set
    %dt= User.human_attribute_name(:formal_name)
    %dd= current_user.formal_name? ? current_user.formal_name : not_set
    %dt= User.human_attribute_name(:email_name)
    %dd= current_user.email_name? ? current_user.email_name : not_set
    - current_user.alternate_names.grouped_by_category.each do |category, ans|
      %dt= t(category, scope: 'alternate_name_categories')
      %dd
        %ul.list-disc
          - ans.each do |an|
            %li= an.name
