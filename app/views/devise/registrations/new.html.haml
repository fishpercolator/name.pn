%section.mx-auto.w-full.max-w-xl.px-4.py-12
  %h1.mb-6.text-4xl.font-bold= title t('.title')
  = simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f|
    .space-y-5
      .card.bg-base-100.shadow-md
        .card-body
          = f.input :email, autofocus: true, label: t('.email'), hint: t('.email_hint')
          = f.input :password, label: t('.password')
          = f.input :password_confirmation
      .card.bg-base-100.shadow-md
        .card-body
          = f.input :subscribe_to_mailing_list, as: :boolean, input_html: {checked: true}
      .card.bg-base-100.shadow-md
        .card-body{class: '[&_a]:link'}
          %p= t('.privacy_notice_html', url: page_path('privacy'))
      = f.input :terms, as: :boolean, label: t('.terms_label_html', url: page_path('terms'))
      = f.button :submit, t('.submit'), class: 'btn-secondary'
  = render "devise/shared/links"
