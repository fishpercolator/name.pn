.mx-auto.w-full.max-w-xl.space-y-12.px-4.py-12
  %section
    %h1.page-title.mb-6.text-4xl.font-bold= title t('.title')
    .card.bg-base-100.shadow-md
      .card-body
        = simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f|
          = f.error_notification
          = f.input :email, required: true, autofocus: true
          = f.input :password, autocomplete: "off", hint: t('.password_hint'), required: false
          = f.input :password_confirmation, required: false
          = f.input :current_password, hint: t('.current_password_hint'), required: true
          = f.button :submit, t('.save'), class: 'btn-secondary mt-4'
  %section
    = turbo_frame_tag [current_user, "mailing_list"], src: users_mailing_list_path
  %section
    %h2.text-2xl.font-bold= t('.api_keys')
    %p.mt-2.mb-4.text-xl{class: '[&_a]:link'}= t('.api_keys_blurb_html', href: link_to(t('.api'), rswag_ui_path, data: {turbo: false}))
    .card.bg-base-100.shadow-md
      .overflow-x-auto
        %table.table.text-base{class: '[&_th]:text-base [&_th]:text-base-content'}
          %thead
            %tr
              %th#client-name-th= Client.human_attribute_name(:name)
              %th= Client.human_attribute_name(:created_at)
              %th
          %tbody
            = render partial: 'clients/client', collection: @clients
            %tr.new-api-key
              %td
                = form_for @new_client do |f|
                  = f.text_field(:name, class: 'input w-full', required: true, placeholder: t('.new_client_placeholder'), aria: {labelledby: 'client-name-th'})
              %td
                %button.btn.btn-success{type: 'submit', form: 'new_client'}
                  = icon 'plus'
                  = t('.new_client')
              %td
  %section
    = link_to t('.cancel'), registration_path(resource_name), class: 'link link-secondary', data: {turbo_confirm: t('.cancel_confirm'), turbo_method: :delete}

-# If we've been redirected here after creating a key
- if @new_key.present?
  = render 'clients/key_modal', key: @new_key
