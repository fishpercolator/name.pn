- data ||= {}
- button_class ||= 'btn-secondary'
.player{data: data.merge({controller: 'player'})}
  %audio{controls: false, data: {player_target: 'media'}}
  %button.btn{class: button_class, type: 'button', data: {player_target: 'play', action: 'player#play'}, disabled: true}
    = icon 'play'
    = t('.listen')
