- title @user.full_name
%section.container.mx-auto.px-4.py-12{data: {controller: 'public-profile', action: 'hashchange@window->public-profile#hashChange'}}
  %div{class: 'mx-auto md:w-1/2'}
    = render 'name_and_pronoun_card', user: @user, pronoun_sets: @pronoun_sets
    = render 'pronunciation_card', user: @user
    = render 'name_details_card', user: @user
    = render 'likeness_card', user: @user
    = render 'pronouns_card', user: @user, pronoun_sets: @pronoun_sets
    = render 'links_card', user: @user
.p-4.text-center
  = link_to t('.blurb'), root_path, class: 'link text-base-200'
