.napc.rounded-box.bg-primary.p-8.text-center.text-primary-content{data: {controller: 'napc'}}
  %h1.mb-2.leading-none.font-bold{class: 'text-[4rem]'}= t('.hello')
  %h2.my-2.italic{class: 'text-[2rem]'}= t('.my_name_is')
  %div{class: 'h-[9.5rem] rounded-box bg-base-100 px-8 py-4 font-handwriting text-[5rem] leading-[7.5rem] text-black'}
    %p.inline-block.whitespace-nowrap.align-top{data: {napc_target: 'fit', max_size: 120}}= user.personal_name
  %h2.my-2.italic{class: 'text-[2rem]'}= t('.my_pronouns_are')
  %div{class: 'rounded-box bg-base-100 px-8 py-4 font-handwriting text-5xl leading-[4.5rem] text-black'}
    .inline-block.whitespace-nowrap.align-top{data: {napc_target: 'fit'}}
      - if user.pronounless_style
        %p= user.pronounless_style.humanize
      - else
        - pronoun_sets.each do |ps|
          %p= ps.to_s(user)
