- if @user.links.present?
  %article.profile-card.group.card.mt-6.overflow-hidden.bg-base-100.shadow-md#links{data: {public_profile_target: 'card'}}
    %header.flex.items-center.justify-between.bg-accent.px-4.py-3.text-accent-content
      %h2.profile-card__title.text-2xl.font-bold= t('.more_about_me')
      = section_link 'links'
    .card-body.text-2xl
      .profile-card__hint.text-base.text-muted= t('.links_hint', name: @user.personal_name)
      %ul.list-inside.list-disc
        - @user.links.order(:title).each do |link|
          %li= link_to link.title, link.url, rel: 'me nofollow', class: 'link link-secondary'
    = see_all
