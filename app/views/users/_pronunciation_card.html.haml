- if user.phonetic.present? || user.ipa.present? || user.pronunciation.attached?
  %article.profile-card.group.card.mt-6.overflow-hidden.bg-base-100.shadow-md#pronunciation{data: {public_profile_target: 'card'}}
    %header.flex.items-center.justify-between.bg-accent.px-4.py-3.text-accent-content
      %h2.profile-card__title.text-2xl.font-bold= t('.how_to_pronounce_my_name')
      = section_link 'pronunciation'
    .card-body.gap-0.text-2xl
      %h3.profile-card__heading.text-accent= t(".headings.phonetic", name: user.pronunciation_of_name, value: user.phonetic)
      .profile-card__name.flex.flex-wrap.items-center.gap-4.font-bold
        - if user.phonetic.present?
          %span= user.phonetic
        - if user.ipa.present?
          %span.profile-card__ipa.font-ipa.text-xl.font-normal{class: 'text-base-content/50'} /#{user.ipa}/
        - if user.pronunciation.attached?
          = render 'player', data: {player_url_value: url_for(user.pronunciation)}
      .profile-card__hint.text-base.text-muted= t(".hints.phonetic", name: user.pronunciation_of_name, value: user.phonetic)
    = see_all
