.profile-card__pronoun.mt-8
  %h3.profile-card__heading.text-accent= pronoun_set.to_s(user)
  - %i[name nominative oblique possessive_determiner possessive reflexive].each do |inflex|
    - pronoun = (inflex == :name ? user.personal_name : pronoun_set.public_send(inflex))
    %p.mt-3.text-xl= raw(t inflex, scope: "pronoun_examples.#{user.pronoun_example}", pronoun: pronoun, pronoun_initial: pronoun.capitalize, nominative: pronoun_set.nominative, nominative_initial: pronoun_set.nominative.capitalize, copula: pronoun_set.copula, personal_name: user.personal_name)
