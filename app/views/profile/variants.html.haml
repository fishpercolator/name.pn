= simple_form_for @user, url: wizard_path, method: :patch do |f|
  = render 'header', f: f
  %section.container.mx-auto.px-4.py-8
    .profile-form.card.mx-auto.overflow-hidden.bg-base-100.shadow-md#variants{class: 'md:w-1/2'}
      .card-body{class: 'bg-variants'}
        %h1.text-3xl.font-bold= title t('.title')
        %p.text-muted= t('.blurb')
        %p.mb-2.text-muted= t('profile.show.optional_section')
        = f.input :envelope_name
        = f.input :formal_name
        = f.input :email_name
        #alternate_names.mt-4.space-y-3
          %h2.text-xl.font-bold= t('.alternate_names')
          %p.text-muted= t('.alternate_names_blurb')
          = f.simple_fields_for :alternate_names do |alternate_name|
            = render 'alternate_name_fields', f: alternate_name
          .alternate_names
            = link_to_add_association f, :alternate_names, class: 'btn btn-success' do
              = icon 'plus-box'
              = t('.add_alternate_name')
        = render 'buttons', f: f
