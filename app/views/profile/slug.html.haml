= simple_form_for @user, url: wizard_path, method: :patch do |f|
  = render 'header', f: f
  %section.container.mx-auto.px-4.py-8
    .profile-form.card.mx-auto.overflow-hidden.bg-base-100.shadow-md#url{class: 'md:w-1/2'}
      .card-body{class: 'bg-url'}
        %h1.text-3xl.font-bold= title t('.title')
        %p.text-muted= t('.blurb')
        %p.mb-2.text-muted= t('profile.show.you_must_complete')
        = f.input :slug, as: :slug
        = f.input :noindex
        %h2.mt-4.text-xl.font-bold= t('.the_rest_is_optional')
        %p.text-muted= t('.optional_blurb')
        %div
          = f.button :button, value: 'finish', class: 'btn-success' do
            = icon 'content-save'
            = t('.save_and_exit')
        %p.text-muted= t('.or_continue')
        = render 'buttons', f: f
