= simple_form_for @user, url: wizard_path, method: :patch do |f|
  = render 'header', f: f
  - pronunciation_of_tag = content_tag(:span, f.object.pronunciation_of_name, data: {pronunciation_form_target: 'output'})
  %section.container.mx-auto.px-4.py-8
    .profile-form.card.mx-auto.overflow-hidden.bg-base-100.shadow-md#pronunciation{class: 'md:w-1/2', data: {controller: 'pronunciation-form'}}
      .card-body{class: 'bg-pronunciation'}
        %h1.text-3xl.font-bold= title t('.title')
        %p.text-muted= t('.blurb')
        %p.mb-2.text-muted= t('profile.show.optional_section')
        = f.input :pronunciation_of, as: :select, collection: pronunciation_of_options(@user), include_blank: false, input_html: {data: {action: 'pronunciation-form#changeChoice'}}
        = f.input :phonetic, label: raw(t 'simple_form.labels.user.phonetic', name: pronunciation_of_tag)
        .fieldset.text-base
          %span.fieldset-legend.block= raw t('.record', name: pronunciation_of_tag)
          = render 'recorder', f: f
        = f.input :ipa, input_html: {class: 'font-ipa'}
        = render 'buttons', f: f
