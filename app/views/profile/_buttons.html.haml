%nav.mt-8.flex.items-center.justify-between.gap-2
  %div
    - if previous_step != step
      = link_to previous_wizard_path, class: 'btn' do
        = icon 'chevron-left'
        = t('.previous')
  - if next_step == Wicked::FINISH_STEP
    = f.button :button, value: 'finish', class: 'btn-primary' do
      = t('.finish')
      = icon 'page-last'
  - else
    = f.button :button, class: 'btn-secondary' do
      = t('.next')
      = icon 'chevron-right'
