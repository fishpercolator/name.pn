.likeness_uploader.flex.items-start.justify-between.gap-4{data: {controller: 'likeness-uploader'}}
  .flex.flex-col.gap-2
    %button.btn.btn-success.btn-lg{type: 'button', data: {action: 'likeness-uploader#start'}}
      = icon 'file-upload-outline'
      = t('.upload_button')
    = f.button :button, value: 'delete_likeness', class: 'btn-danger btn-lg', disabled: !f.object.likeness.attached?, data: {likeness_uploader_target: 'delete'} do
      = icon 'delete'
      = t('.delete_button')
  %div{class: '[&_img]:rounded-full', data: {likeness_uploader_target: 'preview'}}
    - if f.object.likeness.attached?
      = image_tag f.object.likeness.variant(resize_to_limit: [300, 300])
