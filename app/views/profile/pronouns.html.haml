= simple_form_for @user, url: wizard_path, method: :patch do |f|
  = render 'header', f: f
  %section.container.mx-auto.px-4.py-8
    .profile-form.card.mx-auto.overflow-hidden.bg-base-100.shadow-md#pronouns{class: 'md:w-1/2', data: {controller: 'pronoun-form'}}
      .card-body{class: 'bg-pronouns'}
        %h1.text-3xl.font-bold= title t('.title')
        - t('.blurb').each do |para|
          %p.text-muted= para
        %p.mb-2.text-muted= t('profile.show.you_must_complete')
        .profile-pronouns.space-y-6{data: {pronoun_form_target: 'list'}}
          = f.simple_fields_for :user_pronoun_sets do |ff|
            = render 'user_pronoun_set_fields', f: ff
          - @additional_ups.each do |ups|
            = f.simple_fields_for :user_pronoun_sets, ups do |ff|
              = render 'user_pronoun_set_fields', f: ff
        %p.my-3.text-muted= t('.get_in_touch')
        = f.input :pronounless_style, as: :select, collection: User.pronounless_styles.keys.map {|ps| [t(ps, scope: 'pronounless_styles'), ps]}, include_blank: t('pronounless_styles.na'), input_html: {data: {pronoun_form_target: 'pronounless', action: 'pronoun-form#changePronounless'}}
        = f.input :pronoun_style, as: :select, collection: User.pronoun_styles.keys.map {|ps| [t(ps, scope: 'pronoun_styles'), ps]}, include_blank: false
        = f.input :pronoun_example, as: :select, collection: User.pronoun_examples.keys.map {|pe| [t(pe, scope: 'pronoun_example_headings'), pe]}, include_blank: false
        = render 'buttons', f: f
