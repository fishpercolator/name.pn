= simple_form_for @user, url: wizard_path, method: :patch do |f|
  = render 'header', f: f
  %section.container.mx-auto.px-4.py-8
    .profile-form.card.mx-auto.overflow-hidden.bg-base-100.shadow-md#links{class: 'md:w-1/2'}
      .card-body{class: 'bg-links'}
        %h1.text-3xl.font-bold= title t('.title')
        %p.text-muted= t('.blurb')
        #links.space-y-3
          = f.simple_fields_for :links do |link|
            = render 'link_fields', f: link
          .links
            = link_to_add_association f, :links, class: 'btn btn-success' do
              = icon 'plus-box'
              = t('.add_link')
        = render 'buttons', f: f
