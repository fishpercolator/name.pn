- ps ||= f.object&.pronoun_set
- user ||= f.object&.user
= f.hidden_field :pronoun_set_id
.profile-pronouns__option
  = f.label :_destroy, class: 'flex cursor-pointer items-start gap-2 text-xl font-bold' do
    %span.hidden.cursor-grab{data: {pronoun_form_target: 'handle'}}
      = icon 'drag', class: 'size-6 fill-current'
    = f.number_field :position, title: t('.position_hint'), class: 'input input-sm w-16', data: {pronoun_form_target: 'position'}
    = f.check_box :_destroy, {checked: f.object.persisted?, class: 'checkbox mt-0.5 bg-base-100', data: {pronoun_form_target: 'option'}}, '0', '1'
    %span
      = ps.to_s
      %span.hint.block.text-base.font-normal.text-muted= raw t('.pronoun_set_hint', name: user.personal_name, nominative: ps.nominative, oblique: ps.oblique, copula: ps.copula)
