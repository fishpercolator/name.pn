- nojs = 'recorder__nojs in-[.recorder--granted]:hidden in-[.recorder--prompt]:hidden in-[.recorder--denied]:hidden'
.recorder.space-y-2{data: {controller: 'recorder', recorder_granted_class: 'recorder--granted', recorder_prompt_class: 'recorder--prompt', recorder_denied_class: 'recorder--denied', recorder_mock_permission_value: params[:mock_permission]}}
  -# https://web.dev/media-recording-audio/
  = f.fields_for :pronunciation do |pf|
    = pf.input :data, as: :file, input_html: {accept: 'audio/wav', capture: '', data: {recorder_target: 'field', action: 'recorder#recorded'}}, wrapper_class: nojs
    = pf.input :delete, as: :boolean, include_hidden: false, input_html: {data: {recorder_target: 'deleteFlag'}}, wrapper_class: nojs
  .recorder__available.hidden{class: 'in-[.recorder--granted]:block'}
    .flex.flex-col.gap-2.select-none{class: 'xl:flex-row xl:[&>*]:flex-1 [&_.btn]:w-full [&_.btn]:whitespace-nowrap [&_.btn]:font-normal'}
      %button.recorder__button.btn.btn-primary.btn-lg{type: 'button', class: '[&.is-active]:cursor-progress [&.is-waiting]:cursor-wait', data: {recorder_target: 'button', action: 'pointerdown->recorder#start pointerup->recorder#stop pointerleave->recorder#stop'}}
        = icon 'record-circle', class: 'size-[1em] fill-current in-[.is-active]:animate-pulse in-[.is-waiting]:hidden'
        = icon 'timer-sand', class: 'hidden size-[1em] fill-current in-[.is-waiting]:inline'
        %span{class: 'in-[.is-active]:hidden in-[.is-waiting]:hidden'}= t('.record')
        %span.hidden{class: 'in-[.is-waiting]:inline'}= t('.please_wait')
        %span.hidden{class: 'in-[.is-active]:inline'}= t('.recording')
      = render Components::UI::Player.new((url_for(f.object.pronunciation) if f.object.pronunciation.attached? && !f.object.errors[:pronunciation].any?), variant: :success, size: :lg, data: {recorder_target: 'player'})
      %button.btn.btn-secondary.btn-lg{type: 'button', disabled: true, data: {recorder_target: 'delete', action: 'recorder#delete'}}
        = icon 'delete'
        = t('.delete_audio')
  %p.error.text-sm.text-error{class: 'empty:hidden'}= f.error :pronunciation
  %p.hint.text-sm.text-muted= t('.hint')
  .recorder__prompt-form.hidden.space-y-2{class: 'in-[.recorder--prompt]:block'}
    %button.recorder__prompt.btn.btn-secondary.btn-lg.h-auto.w-full.py-2{type: 'button', data: {action: 'recorder#prompt'}}
      = icon 'microphone-question'
      = t('.prompt')
    %p.hint.text-sm.text-muted= t('.prompt_hint')
  .recorder__denied.alert.alert-error.hidden{role: 'alert', class: 'in-[.recorder--denied]:flex'}
    = icon 'alert', class: 'size-6 fill-current'
    %span= t('.recorder_denied')
  .recorder__unavailable.alert.alert-warning{role: 'alert', class: 'in-[.recorder--granted]:hidden in-[.recorder--prompt]:hidden in-[.recorder--denied]:hidden'}
    = icon 'alert', class: 'size-6 fill-current'
    %span= t('.recorder_unavailable')
